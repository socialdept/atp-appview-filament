{
    "name": "socialdept/atp-appview-filament",
    "description": "Run and inspect AT Protocol AppViews from a Filament panel in Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "atproto",
        "appview",
        "filament",
        "laravel"
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/support": "^11.28|^12.0|^13.0",
        "socialdept/atp-appview": "dev-main"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "friendsofphp/php-cs-fixer": "^3.89"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/socialdept/atp-appview"
        }
    ],
    "autoload": {
        "psr-4": {
            "SocialDept\\AtpAppviewFilament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SocialDept\\AtpAppviewFilament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SocialDept\\AtpAppviewFilament\\AtpAppviewFilamentServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
